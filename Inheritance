#include<iostream>
using namespace std;

class Animal {
public:
    void Eat() {
        cout << "Animal is Eating\n";
    }
    void Run() {
        cout << "Animal is Running\n";
    }
    void Speak() {
        cout << "Animal is Speaking\n";
    }
};
class Dog : public Animal {
public:
    void Eat() {
        cout << "Dog Eating meat\n";
    }
    void Speak() {
        cout << "Dog is barking\n";
    }
};
int main() {
    Dog D;
    D.Eat();
    D.Run();
    D.Speak();

    return 0;
}
